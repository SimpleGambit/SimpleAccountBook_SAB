<Window x:Class="SimpleAccountBook.BudgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="예상 지출 · 거래 정리 · 통계" Width="1240" Height="850" MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="29"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource TextBoxBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><TextBlock Text="▾" HorizontalAlignment="Right" Margin="0,0,7,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="6,3,25,3" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Padding" Value="6,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18,10"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/><Setter Property="RowBackground" Value="{DynamicResource ListBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="MinRowHeight" Value="30"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource GridViewColumnHeaderBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Padding" Value="7,8"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="5,3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger></Style.Triggers></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,9,0,4"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="예상 지출과 실제 거래를 함께 관리합니다" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TabControl x:Name="MainTabs">
            <TabItem Header="예상 지출">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"><Button Content="◀" Click="PreviousMonth_Click"/><TextBlock x:Name="MonthText" FontSize="17" FontWeight="SemiBold" Margin="8,0,14,0"/><Button Content="▶" Click="NextMonth_Click"/><Button Content="이번 달" Click="ThisMonth_Click"/></StackPanel>
                    <TextBlock x:Name="ForecastText" Grid.Row="1" Margin="0,12" FontSize="14" TextWrapping="Wrap"/>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                        <Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="0.6*"/></Grid.RowDefinitions>
                            <DataGrid x:Name="PlansGrid" SelectionMode="Single" SelectionChanged="PlansGrid_SelectionChanged"><DataGrid.Columns>
                                <DataGridTextColumn Header="항목" Binding="{Binding Plan.Name}" Width="*"/><DataGridTextColumn Header="구분" Binding="{Binding KindText}" Width="55"/><DataGridTextColumn Header="예상" Binding="{Binding Expected, StringFormat=N0}" Width="85"/><DataGridTextColumn Header="실제" Binding="{Binding Actual, StringFormat=N0}" Width="85"/><DataGridTextColumn Header="남은 예상액" Binding="{Binding Remaining, StringFormat=N0}" Width="90"/><DataGridTextColumn Header="초과" Binding="{Binding Overrun, StringFormat=N0}" Width="80"/><DataGridTextColumn Header="예정일" Binding="{Binding DueDate, StringFormat=MM-dd}" Width="65"/>
                            </DataGrid.Columns></DataGrid>
                            <TextBlock Grid.Row="1" Text="기타 실제 지출 · 예상 항목에 연결되지 않은 거래" Margin="0,14,0,7" FontWeight="SemiBold"/>
                            <DataGrid x:Name="OtherGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="날짜" Binding="{Binding Record.TransactionTime, StringFormat=MM-dd}" Width="70"/><DataGridTextColumn Header="내역" Binding="{Binding Record.Description}" Width="*"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="실제 지출" Binding="{Binding Expense, StringFormat=N0}" Width="100"/></DataGrid.Columns></DataGrid>
                        </Grid>
                        <DockPanel Grid.Column="1"><WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Content="저장" Click="SavePlan_Click"/><Button Content="선택 월부터 종료" Click="EndPlan_Click"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="PlanEditorTitle" Text="새 예상 지출" FontSize="16" FontWeight="SemiBold"/><Button Content="새 항목" Margin="15,0,0,0" Click="NewPlan_Click"/></StackPanel>
                            <TextBlock Text="등록 항목 선택 (다른 예정월 포함)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PlanEditorSelection" DisplayMemberPath="Name" SelectionChanged="PlanEditorSelection_SelectionChanged"/><TextBlock Text="항목 이름" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PlanName"/>
                            <TextBlock Text="구분 / 예상 금액 (원)" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="PlanKind" SelectedIndex="0"><ComboBoxItem Content="고정 지출"/><ComboBoxItem Content="변동 지출"/></ComboBox><TextBox x:Name="PlanAmount" Grid.Column="1" Margin="8,0,0,0"/></Grid>
                            <TextBlock Text="분류" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PlanCategory"/>
                            <TextBlock Text="결제 예정일 (1~31) / 반복 간격 (개월)" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="PlanDay" Text="1"/><TextBox x:Name="PlanInterval" Grid.Column="1" Text="1" Margin="8,0,0,0"/></Grid>
                            <TextBlock Text="시작 월 / 마지막 월 (yyyy-MM, 종료 없음은 공란)" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="PlanStart"/><TextBox x:Name="PlanEnd" Grid.Column="1" Margin="8,0,0,0"/></Grid>
                            <TextBlock Text="메모" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PlanNote" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                            <TextBlock Text="수정은 위에서 선택한 월부터 적용됩니다. 이전 월의 예상액은 유지되며, 종료하면 선택 월부터 예상액이 발생하지 않습니다." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12"/>
                            
                            <TextBlock Text="금액은 원 단위입니다. 말일보다 큰 예정일은 해당 월의 말일로 계산합니다. 실제 거래 연결은 ‘거래 정리’에서 할 수 있습니다." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0"/>
                        </StackPanel></ScrollViewer></DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="거래 정리">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10"><TextBlock Text="검색" Margin="0,0,7,0"/><TextBox x:Name="TransactionSearch" Width="220" ToolTip="내역, 분류, 태그 검색" TextChanged="TransactionFilter_Changed"/><CheckBox x:Name="OnlySelectedMonth" Content="예상 지출에서 선택한 월만" Margin="12,0" Checked="TransactionFilter_Changed" Unchecked="TransactionFilter_Changed"/><ComboBox x:Name="CategoryFilter" Width="140" SelectionChanged="TransactionFilter_Changed"/><ComboBox x:Name="StatusFilter" Width="170" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="TransactionFilter_Changed"><ComboBoxItem Content="모든 거래"/><ComboBoxItem Content="수입"/><ComboBoxItem Content="지출"/><ComboBoxItem Content="기타 실제 지출"/><ComboBoxItem Content="본인 계좌 간 이체"/><ComboBoxItem Content="환불 연결"/><ComboBoxItem Content="통계 제외"/><ComboBoxItem Content="이체 후보"/></ComboBox></WrapPanel>
                    <DataGrid x:Name="TransactionsGrid" Grid.Row="1" SelectionMode="Extended"><DataGrid.Columns>
                        <DataGridTextColumn Header="일시" Binding="{Binding Record.TransactionTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/><DataGridTextColumn Header="구분" Binding="{Binding Record.TransactionType}" Width="50"/><DataGridTextColumn Header="내역" Binding="{Binding Record.Description}" Width="*"/><DataGridTextColumn Header="원본 금액" Binding="{Binding Record.Amount, StringFormat=N0}" Width="90"/><DataGridTextColumn Header="통계 금액" Binding="{Binding Net, StringFormat=N0}" Width="90"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="85"/><DataGridTextColumn Header="태그" Binding="{Binding Record.Tags}" Width="100"/><DataGridTextColumn Header="예상 항목" Binding="{Binding PlanName}" Width="90"/><DataGridTextColumn Header="거래 계좌" Binding="{Binding AccountName}" Width="95"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="145"/>
                    </DataGrid.Columns></DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Ctrl / Shift로 여러 거래를 선택하면 일괄 적용됩니다. 열 제목을 누르면 정렬됩니다." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,7"><TextBlock Text="분류" Margin="0,0,6,0"/><TextBox x:Name="BulkCategory" Width="120"/><Button Content="분류 적용" Margin="6,0,16,0" Click="SetCategory_Click"/><TextBlock Text="태그" Margin="0,0,6,0"/><TextBox x:Name="BulkTags" Width="140"/><Button Content="태그 적용" Margin="6,0,16,0" Click="SetTags_Click"/><ComboBox x:Name="LinkPlan" Width="155" DisplayMemberPath="Name"/><Button Content="예상 항목 연결" Margin="6,0,6,0" Click="LinkPlan_Click"/><Button Content="연결 해제" Click="UnlinkPlan_Click"/></WrapPanel>
                        <WrapPanel Margin="0,0,0,7"><TextBlock Text="거래 계좌" Margin="0,0,6,0"/><ComboBox x:Name="SourceAccount" Width="160" DisplayMemberPath="Name"/><Button Content="계좌 지정" Margin="6,0,16,0" Click="SetSourceAccount_Click"/><Button Content="계좌 해제" Click="ClearSourceAccount_Click"/><TextBlock Text="상대 본인 계좌" Margin="0,0,6,0"/><ComboBox x:Name="TransferAccount" Width="160" DisplayMemberPath="Name"/><Button Content="본인 이체 확정" Margin="6,0,6,0" Click="ConfirmTransfer_Click"/><Button Content="이체 해제" Click="UnlinkTransfer_Click"/></WrapPanel>
                        <WrapPanel><Button Content="선택한 입금 + 지출을 환불로 연결" Click="LinkRefund_Click"/><Button Content="선택 거래의 환불 연결 해제" Click="UnlinkRefund_Click"/></WrapPanel>
                        <TextBlock Text="본인 이체는 등록한 서로 다른 본인 계좌끼리만 지정합니다. 거래 계좌를 먼저 지정하고, 반대편 입출금도 각각 확정하세요. 별도 수수료는 지출로 남겨 두세요. 환불은 실제 입금된 거래만 원래 지출과 연결합니다." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="최근 12개월">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.1*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="StatsPeriodText" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatsTotalText" Grid.Row="1" Margin="0,10" FontSize="15"/>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="MonthlyGrid" SelectionMode="Single" SelectionChanged="MonthlyGrid_SelectionChanged" Margin="0,0,12,0"><DataGrid.Columns><DataGridTextColumn Header="월" Binding="{Binding Month, StringFormat=yyyy-MM}" Width="85"/><DataGridTextColumn Header="수입" Binding="{Binding Income, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="지출" Binding="{Binding Expense, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="차액" Binding="{Binding Net, StringFormat=N0}" Width="*"/></DataGrid.Columns></DataGrid>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="월별 수입 / 지출" Margin="0,0,0,6"/><ItemsControl x:Name="ChartItems"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Month, StringFormat=yy-MM}"/><StackPanel Grid.Column="1"><ProgressBar Value="{Binding Income, Mode=OneWay}" Maximum="{Binding Maximum}" Height="7" Foreground="{DynamicResource IncomeTextBrush}" Background="{DynamicResource PanelBackgroundBrush}" BorderThickness="0" ToolTip="{Binding Income, StringFormat=수입 {0:N0}원}"/><ProgressBar Value="{Binding Expense, Mode=OneWay}" Maximum="{Binding Maximum}" Height="7" Margin="0,2,0,0" Foreground="{DynamicResource ExpenseTextBrush}" Background="{DynamicResource PanelBackgroundBrush}" BorderThickness="0" ToolTip="{Binding Expense, StringFormat=지출 {0:N0}원}"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
                    </Grid>
                    <WrapPanel Grid.Row="3" Margin="0,12,0,8"><TextBlock x:Name="StatsSelectionText" Text="전체 기간 내역" Margin="0,0,12,0"/><Button Content="전체 기간" Click="ClearStatsMonth_Click"/><TextBox x:Name="StatsSearch" Width="190" Margin="10,0" ToolTip="상세 내역 검색" TextChanged="StatsFilter_Changed"/><ComboBox x:Name="StatsGrouping" Width="125" SelectedIndex="0" SelectionChanged="StatsFilter_Changed"><ComboBoxItem Content="분류별"/><ComboBoxItem Content="거래처별"/><ComboBoxItem Content="월별"/></ComboBox></WrapPanel>
                    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="GroupsGrid" SelectionMode="Single" SelectionChanged="GroupsGrid_SelectionChanged" Margin="0,0,12,0"><DataGrid.Columns><DataGridTextColumn Header="묶음" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="수입" Binding="{Binding Income, StringFormat=N0}" Width="100"/><DataGridTextColumn Header="지출" Binding="{Binding Expense, StringFormat=N0}" Width="100"/></DataGrid.Columns></DataGrid>
                        <DataGrid x:Name="StatsDetailsGrid" Grid.Column="1"><DataGrid.Columns><DataGridTextColumn Header="날짜" Binding="{Binding Record.TransactionTime, StringFormat=yyyy-MM-dd}" Width="90"/><DataGridTextColumn Header="내역" Binding="{Binding Record.Description}" Width="*"/><DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="80"/><DataGridTextColumn Header="수입" Binding="{Binding Income, StringFormat=N0}" Width="85"/><DataGridTextColumn Header="지출" Binding="{Binding Expense, StringFormat=N0}" Width="85"/></DataGrid.Columns></DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="분류">
                <Grid Margin="12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="지출·수입 분류" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid x:Name="CategoriesGrid" Grid.Row="1" SelectionMode="Single" SelectionChanged="CategoriesGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="분류 이름" Binding="{Binding}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="분류 이름" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CategoryName"/><WrapPanel Margin="0,10,0,0"><Button Content="추가" Click="AddCategory_Click"/><Button Content="선택 분류 이름 변경" Click="RenameCategory_Click"/><Button Content="삭제" Click="DeleteCategory_Click" ToolTip="사용하지 않는 분류만 바로 삭제"/></WrapPanel><TextBlock Text="예상 항목과 거래에서 입력한 새 분류도 목록에 추가됩니다. 이름을 변경하면 해당 분류를 쓰는 예상 항목과 거래에도 적용됩니다. 태그는 거래 정리에서 쉼표로 구분해 입력할 수 있습니다." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,14,0,0"/></StackPanel></Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
